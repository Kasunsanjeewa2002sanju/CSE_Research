# ==============================================================================
# Comprehensive .gitignore for CSE Research & Live Platform (NEW Dev)
# Covers: Python (backend & research), Node/TypeScript (frontend), ML caches,
#         live scheduler locks, databases, logs, IDEs, and OS artifacts.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Operating System Files
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.fuse_hidden*
.directory

# ------------------------------------------------------------------------------
# 2. IDE & Editor Files
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (PyCharm, WebStorm, IntelliJ, etc.)
.idea/
*.iml
*.iws
*.ipr

# Visual Studio / MSBuild
*.suo
*.ntvs*
*.njsproj
*.sln
*.user
*.userosscache
*.sln.docstates

# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim / Emacs
*.swp
*.swo
*.sw?
*.bak
\#*\#
.\#*

# ------------------------------------------------------------------------------
# 3. Python Bytecode, C-Extensions & Packaging
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# 4. Python Virtual Environments
# ------------------------------------------------------------------------------
.venv/
venv/
ENV/
env/
*.venv
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# 5. Testing, Code Coverage & Linting Caches
# ------------------------------------------------------------------------------
.pytest_cache/
.cache/
.hypothesis/
.coverage
.coverage.*
coverage/
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.tox/
.nox/
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/

# Test scratch databases / caches
pytest_dbs/
pytest_empty_db/
pytest_sim/

# ------------------------------------------------------------------------------
# 6. Jupyter Notebooks
# ------------------------------------------------------------------------------
.ipynb_checkpoints/
*-checkpoint.ipynb

# ------------------------------------------------------------------------------
# 7. Machine Learning, Deep Learning & Scientific Tooling
# ------------------------------------------------------------------------------
catboost_info/
**/catboost_info/
.matplotlib/
**/matplotlib/
fontlist-*.json
wandb/
lightning_logs/

# Ephemeral vector search indices & local embedding caches (regenerable)
*.faiss
*embedding_cache.pkl
*empty.faiss
*empty.pkl
*isolated_index.faiss
*isolated_meta.pkl
*news_index.faiss
*news_index_meta.pkl

# Keep frozen research models and model registry tracked
!models/
!**/models/**

# Exclude model binaries exceeding GitHub's 100MB hard limit (associated meta.json is preserved)
**/sarima_m21/*/model.pkl
cse_research/models/statistical/sarima_m21/*/model.pkl

# ------------------------------------------------------------------------------
# 8. Node.js & Frontend (Vite / React / TypeScript)
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
frontend/dist/
frontend/dist-ssr/
*.tsbuildinfo
.eslintcache
.prettiercache
.vite/

# Frontend testing & browser reports
playwright-report/
test-results/
blob-report/
playwright/.cache/

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 9. Environment Variables, Local Configurations & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.template

# Private keys and certificates
*.pem
*.key
*.cert
*.crt

# ------------------------------------------------------------------------------
# 10. Logs & Diagnostics
# ------------------------------------------------------------------------------
logs/
**/logs/
*.log
*.log.*
append_audit.log
feature_fallbacks.log
prior_calls.log

# ------------------------------------------------------------------------------
# 11. Live Data Caches, Runtime Locks & SQLite Databases
# ------------------------------------------------------------------------------
# Live scraper/service cache and transient data
cse_data_cache/
**/cse_data_cache/
scratch/
**/scratch/

# Runtime scheduler and process locks
.cse_live_scheduler.lock
*.pid
*.pid.lock

# SQLite database files and lock journals
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.db-journal
*.sqlite-journal

# ------------------------------------------------------------------------------
# 12. Lockfile Inclusions (Ensure dependency lockfiles are tracked)
# ------------------------------------------------------------------------------
!package-lock.json
!yarn.lock
!pnpm-lock.yaml
!uv.lock

